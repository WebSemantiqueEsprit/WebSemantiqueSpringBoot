    <untitled-ontology-4:hasType>Individuelle</untitled-ontology-4:hasType>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ghazi/ontologies/2024/8/untitled-ontology-4#CarbonFootprint"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ghazi/ontologies/2024/8/untitled-ontology-4#CarbonReductionStrategy"/>
    <untitled-ontology-4:Test>
      <untitled-ontology-4:CarbonReductionStrategy rdf:about="http://www.semanticweb.org/ghazi/ontologies/2024/8/untitled-ontology-4#Reduction_Solaire">
