        <untitled-ontology-4:hasCost rdf:datatype="http://www.w3.org/2001/XMLSchema#float"
        >8000.0</untitled-ontology-4:hasCost>
        <untitled-ontology-4:usesOptimizationSolution>
          <untitled-ontology-4:OptimizationSolution rdf:about="http://www.semanticweb.org/ghazi/ontologies/2024/8/untitled-ontology-4#Marie_SolarPanels">
            <untitled-ontology-4:hasImplementationCost rdf:datatype=
            "http://www.w3.org/2001/XMLSchema#float">8000.0</untitled-ontology-4:hasImplementationCost>
            <untitled-ontology-4:hasCostSavings rdf:datatype=
            "http://www.w3.org/2001/XMLSchema#float">1000.0</untitled-ontology-4:hasCostSavings>
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
          </untitled-ontology-4:OptimizationSolution>
        </untitled-ontology-4:usesOptimizationSolution>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
      </untitled-ontology-4:CarbonReductionStrategy>
    </untitled-ontology-4:Test>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
